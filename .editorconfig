# Lint / code-style rules. Checked by `dotnet format` and in CI (.github/workflows/lint.yml).
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,xaml,slnx,config}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.cs]
indent_size = 4
end_of_line = crlf

# usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using

# var / types
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# braces / layout
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# modern C#
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0051.severity = warning   # unused private member
dotnet_diagnostic.IDE0059.severity = warning   # unnecessary assignment
dotnet_diagnostic.IDE0060.severity = suggestion # unused parameter (event handlers)

# naming
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# analyzer tuning for a WPF desktop app
dotnet_diagnostic.CA1303.severity = none   # localized string literals (UI text is Indonesian)
dotnet_diagnostic.CA1305.severity = suggestion # IFormatProvider
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait (UI thread needs context)
dotnet_diagnostic.CA2100.severity = warning # SQL built from strings: use parameters

# generated code
[*.{g.cs,g.i.cs,Designer.cs}]
generated_code = true
