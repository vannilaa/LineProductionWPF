<UserControl x:Class="LineProductionWPF.SerialMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Serial monitor like the Arduino IDE: connect to the ESP port set in Pengaturan, see what arrives, send text.
         Buttons / check boxes are not focusable and the combo boxes are editable+read-only, so the
         dashboard's scanner box (which takes the keyboard focus back) does not fight with this tab. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
            <!-- Port + baud come from Pengaturan (one place to set them); shown here only -->
            <TextBlock x:Name="txtPortInfo" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
            <Button x:Name="btnConnect" Content="Hubungkan" Focusable="False" Padding="12,2" Margin="0,0,12,0"
                    FontWeight="Bold" Click="btnConnect_Click"/>
            <CheckBox x:Name="chkTimestamp" Content="Timestamp" Focusable="False" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="chkAutoscroll" Content="Autoscroll" Focusable="False" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="btnClear" Content="Bersihkan" Focusable="False" Padding="8,2" Click="btnClear_Click"/>
        </WrapPanel>

        <TextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="14"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">
            <Button x:Name="btnSend" DockPanel.Dock="Right" Content="Kirim" Focusable="False" Padding="14,2"
                    Margin="6,0,0,0" Click="btnSend_Click"/>
            <ComboBox x:Name="cbEnding" DockPanel.Dock="Right" Width="150" IsEditable="True" IsReadOnly="True"
                      Margin="6,0,0,0"/>
            <TextBox x:Name="txtSend" KeyDown="txtSend_KeyDown"/>
        </DockPanel>

        <TextBlock x:Name="txtState" Grid.Row="3" Margin="0,6,0,0" Foreground="#6B7280"/>
    </Grid>
</UserControl>
