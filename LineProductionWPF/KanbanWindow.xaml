<Window x:Class="LineProductionWPF.KanbanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban Produksi" Background="#E5E7EB"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Width="1366" Height="768" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
        <Style x:Key="CardBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="84"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CardSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#909090"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="HeaderSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="MinWidth" Value="156"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- kanban boards -->
            <RowDefinition Height="*"/>      <!-- job table -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="White" Padding="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="bdNomorLine" Grid.Column="0" Background="#0234FD" CornerRadius="6"
                        Padding="16,8" Margin="10,0" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="bdNomorLine_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NomorLine" Text="PILIH LINE" FontSize="36" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" ▼" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="PartNomor" Grid.Column="1" Text="-" FontSize="36" FontWeight="Bold"
                           Margin="5,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Margin="5,0" VerticalAlignment="Center">
                    <TextBlock x:Name="JobNo" Text="JOB NO" Style="{StaticResource HeaderSub}"/>
                    <TextBlock x:Name="Posisi" Text="POSISI" Style="{StaticResource HeaderSub}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtClock" Text="" FontSize="24" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtAllDone" Text="" FontSize="18" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= KANBAN BOARDS ================= -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1: planned quantity -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TARGET PRODUKSI" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="job ini" Style="{StaticResource CardCaption}"/>
                    <TextBlock x:Name="txtTarget" Text="0" Style="{StaticResource CardBig}"/>
                    <TextBlock Text="total hari ini" Style="{StaticResource CardCaption}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtTargetHari" Text="/0" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>

            <!-- 2: scanned -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ACTUAL (SCAN)" Style="{StaticResource CardTitle}" Foreground="#0800FF"/>
                    <TextBlock Text="job ini (reset saat job selesai)" Style="{StaticResource CardCaption}"/>
                    <TextBlock x:Name="txtActual" Text="0" Style="{StaticResource CardBig}" Foreground="#0800FF"/>
                    <TextBlock Text="total hari ini" Style="{StaticResource CardCaption}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtActualHari" Text="/0" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>

            <!-- 3: count by pcs per hour -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="COUNT PRODUKSI" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtRate" Text="job ini" Style="{StaticResource CardCaption}"/>
                    <TextBlock x:Name="txtCount" Text="0" Style="{StaticResource CardBig}"/>
                    <TextBlock Text="total hari ini" Style="{StaticResource CardCaption}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtCountHari" Text="/0" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>

            <!-- 4: selisih -->
            <Border x:Name="bdSelisih" Grid.Column="3" Style="{StaticResource Card}" Background="#22C55E">
                <StackPanel>
                    <TextBlock x:Name="txtSelisihTitle" Text="SELISIH" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtSelisihCaption" Text="actual - count, job ini" Style="{StaticResource CardCaption}"/>
                    <TextBlock x:Name="txtSelisih" Text="0" Style="{StaticResource CardBig}"/>
                    <TextBlock x:Name="txtSelisihCaption2" Text="total hari ini" Style="{StaticResource CardCaption}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtSelisihHari" Text="0" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= JOB TABLE ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid x:Name="dgJobs" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderThickness="0"
                      RowHeight="38" FontSize="16" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Urutan"      Binding="{Binding Urutan}"     Width="*"/>
                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="2*"/>
                    <DataGridTextColumn Header="Job No"      Binding="{Binding JobNo}"      Width="1.2*"/>
                    <DataGridTextColumn Header="Posisi"      Binding="{Binding Posisi}"     Width="*"/>
                    <DataGridTextColumn Header="Target/jam"  Binding="{Binding Target}"     Width="*"/>
                    <DataGridTextColumn Header="Jumlah"      Binding="{Binding Jumlah}"     Width="*"/>
                    <DataGridTextColumn Header="Scan"        Binding="{Binding Discan}"     Width="*"/>
                    <DataGridTextColumn Header="Count"       Binding="{Binding Count}"      Width="*"/>
                    <DataGridTextColumn Header="Status"      Binding="{Binding Status}"     Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="3" Background="White" Padding="24,8">
            <Grid>
                <TextBlock x:Name="txtStatus" VerticalAlignment="Center" FontSize="16" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,180,0"/>
                <Button x:Name="btnKembali" Content="KEMBALI" Style="{StaticResource BackButton}"
                        HorizontalAlignment="Right" Click="btnKembali_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
