<Window x:Class="LineProductionWPF.DashboardProduksiELRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LineProductionWPF"
        mc:Ignorable="d"
        Title="Dashboard Produksi ELR"
        Background="#E5E7EB"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Loaded="Window_Loaded" Activated="Window_Activated" Width="1366" Height="768">

    <Window.Resources>
        <!-- ===== Buttons ===== -->
        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
        </Style>
        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="MinWidth" Value="156"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ===== Header text ===== -->
        <Style x:Key="HeaderSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- ===== KPI cards ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CardBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="72"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CardSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="72"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="#909090"/>
            <Setter Property="LineHeight" Value="54"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <!-- ===== Table ===== -->
        <!-- Header: light gray, text wraps onto two lines -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows: light blue, peach on every second row, blue-lilac when selected -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#EFF6FC"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAEBD7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE3FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cells: no border, no default blue selection, text centered vertically -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- KPI cards -->
            <RowDefinition Height="*"/>      <!-- scan panel + tabs -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="White" Padding="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- line number -->
                    <ColumnDefinition Width="Auto"/>   <!-- part number -->
                    <ColumnDefinition Width="Auto"/>   <!-- job no / posisi -->
                    <ColumnDefinition Width="*"/>      <!-- empty space: pushes the rest right -->
                    <ColumnDefinition Width="Auto"/>   <!-- buttons 1 -->
                    <ColumnDefinition Width="Auto"/>   <!-- buttons 2 -->
                    <ColumnDefinition Width="Auto"/>   <!-- clock -->
                </Grid.ColumnDefinitions>

                <Border x:Name="bdNomorLine" Grid.Column="0" Background="#0234FD" CornerRadius="6"
                     Padding="16,8" Margin="10,0" VerticalAlignment="Center"
                     Cursor="Hand" MouseLeftButtonUp="bdNomorLine_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NomorLine" Text="NOMOR  LINE"
                             FontSize="36" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" ▼" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PartNomor" Grid.Column="1" Text="PART NOMOR"
                           FontSize="36" FontWeight="Bold" Margin="5,0"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Margin="5,0" VerticalAlignment="Center">
                    <TextBlock x:Name="JobNo" Text="JOB NO" Style="{StaticResource HeaderSub}"/>
                    <TextBlock x:Name="Posisi" Text="POSISI" Style="{StaticResource HeaderSub}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <Button Content="Kendala" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Ganti Target" Style="{StaticResource HeaderButton}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <Button Content="Cetak Ulang" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Stop Counter" Style="{StaticResource StopButton}"/>
                </StackPanel>

                <TextBlock x:Name="txtClock" Grid.Column="6" Text="28 Oktober 2026 14:56:12"
                           FontSize="24" Margin="10,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= KPI CARDS ================= -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TARGET PRODUKSI" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtTarget" Text="999" Style="{StaticResource CardBig}"/>
                    <TextBlock x:Name="txtTargetJam" Text="/999" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACTUAL PRODUKSI" Style="{StaticResource CardTitle}" Foreground="#0800FF"/>
                    <TextBlock x:Name="txtActual" Text="999" Style="{StaticResource CardBig}" Foreground="#0800FF"/>
                    <TextBlock x:Name="txtActualJam" Text="/999" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COUNT PRODUKSI" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtCount" Text="999" Style="{StaticResource CardBig}"/>
                    <TextBlock x:Name="txtCountJam" Text="/999" Style="{StaticResource CardSmall}"/>
                </StackPanel>
            </Border>

            <Border x:Name="bdSelisih" Grid.Column="3" Style="{StaticResource Card}" Background="#EF4444">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtSelisihTitle" Text="SELISIH" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtSelisih" Text="0" Style="{StaticResource CardBig}"/>
                    <TextBlock x:Name="txtSelisihJam" Text="-99" Style="{StaticResource CardSmall}" Foreground="Black"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Row="2" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>   <!-- scan panel: fixed width -->
                <ColumnDefinition Width="*"/>     <!-- tabs: takes the rest -->
            </Grid.ColumnDefinitions>

            <!-- Scan panel -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>   <!-- list fills the rest -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SCAN BARCODE/QR"/>

                    <TextBox x:Name="txtScan" Grid.Row="1" Height="24" Margin="0,5"
                             KeyDown="txtScan_KeyDown"
                             LostKeyboardFocus="txtScan_LostKeyboardFocus"/>

                    <TextBlock x:Name="txtScanPerBox" Grid.Row="2" Text="SCAN per BOX"/>

                    <Border Grid.Row="3" Background="#EEF4FA" Padding="8,4" Margin="0,5,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="txtScanned" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2F6FE4"/>
                                <TextBlock Text=" / " FontSize="24" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock x:Name="txtPerBox" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4B5563"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPallet" Text="Pallet"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lstScans" Grid.Row="4" Margin="0,10,0,0"
                             d:ItemsSource="{d:SampleData ItemCount=20}"
                             BorderBrush="Black" Background="#FFF1E2E2" FontFamily="Consolas"/>
                </Grid>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Column="1" Margin="10" Padding="2,6,2,2">
                <TabItem Header="Jadwal Produksi (Hourly)">
                    <DataGrid x:Name="dgvSchedule"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="White" BorderThickness="0"
                              RowHeight="38" FontSize="14"
                              AlternationCount="2"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              RowStyle="{StaticResource GridRow}"
                              CellStyle="{StaticResource GridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jadwal #"      Binding="{Binding Jadwal}"       Width="*"/>
                            <DataGridTextColumn Header="Jam"           Binding="{Binding Jam}"          Width="*"/>
                            <DataGridTextColumn Header="Part Number"   Binding="{Binding PartNumber}"   Width="1.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Job No"        Binding="{Binding JobNo}"        Width="*"/>
                            <DataGridTextColumn Header="Target"        Binding="{Binding Target}"       Width="*"/>
                            <DataGridTextColumn Header="Jumlah Target" Binding="{Binding JumlahTarget}" Width="*"/>
                            <DataGridTextColumn Header="Actual"        Binding="{Binding Actual}"       Width="*"/>
                            <DataGridTextColumn Header="Jumlah Actual" Binding="{Binding JumlahActual}" Width="*"/>
                            <DataGridTextColumn Header="Selisih"       Binding="{Binding Selisih}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Terima Box / Pallet"/>
                <TabItem Header="Tampilan Web"/>
                <TabItem Header="Log Serial / COM"/>
            </TabControl>
        </Grid>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="3" Background="White" Padding="24,8">
            <Button x:Name="btnKembali" Content="KEMBALI" Style="{StaticResource BackButton}"
                    HorizontalAlignment="Right" Click="btnKembali_Click"/>
        </Border>
    </Grid>
</Window>