<Window x:Class="LineProductionWPF.DashboardProduksiELRWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LineProductionWPF"
        mc:Ignorable="d"
        Title="Dashboard Produksi ELR"
        Background="#E5E7EB"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Loaded="Window_Loaded" Activated="Window_Activated" Width="1366" Height="768">

    <Window.Resources>
        <!-- ===== Buttons ===== -->
        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <!-- compact 2 x 2 block: fixed size so all four buttons are equal and the header stays low -->
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
        </Style>
        <Style x:Key="ExitButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="MinWidth" Value="156"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ===== Header text ===== -->
        <Style x:Key="HeaderSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- ===== KPI cards ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <!-- KPI row: same look as Card, tighter padding and margin -->
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,6,6,2"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CardBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="72"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,-20,0,0"/>
        </Style>

        <!-- Day total, shown as a compact chip between the card title and the big job number:
             small caption on the left, total on the right. The chip background is a translucent
             dark tint so it also works on the coloured Selisih card. -->
        <Style x:Key="TotalChip" TargetType="Border">
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="TotalCaption" TargetType="TextBlock">
            <Setter Property="Text" Value="TOTAL"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Table ===== -->
        <!-- Header: light gray, text wraps onto two lines -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows: light blue, peach on every second row, blue-lilac when selected -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#EFF6FC"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAEBD7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE3FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cells: no border, no default blue selection, text centered vertically -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Time columns of the job table: finished job = normal text, estimate = grey italic.
             The small note under a time says when it contains the break (so nobody reads the break as lateness) or overtime. -->
        <Style x:Key="TimeMain" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProjected}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                    <Setter Property="Foreground" Value="#4B5563"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimeNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#9A3412"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="DarkSlateGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- KPI cards -->
            <RowDefinition Height="*"/>      <!-- scan panel + tabs -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="White" Padding="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- line number -->
                    <ColumnDefinition Width="Auto"/>   <!-- part number -->
                    <ColumnDefinition Width="Auto"/>   <!-- job no / posisi -->
                    <ColumnDefinition Width="*" MinWidth="170"/>   <!-- customer logo + name (takes the free space) -->
                    <ColumnDefinition Width="Auto"/>   <!-- buttons 1 -->
                    <ColumnDefinition Width="Auto"/>   <!-- buttons 2 -->
                    <ColumnDefinition Width="Auto"/>   <!-- date and time -->
                </Grid.ColumnDefinitions>

                <Border x:Name="bdNomorLine" Grid.Column="0" Background="#0234FD" CornerRadius="6"
                     Padding="16,8" Margin="10,0" VerticalAlignment="Center"
                     Cursor="Hand" MouseLeftButtonUp="bdNomorLine_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NomorLine" Text="NOMOR  LINE"
                             FontSize="36" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" ▼" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PartNomor" Grid.Column="1" Text="PART NOMOR"
                           FontSize="36" FontWeight="Bold" Margin="5,0"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Margin="5,0" VerticalAlignment="Center">
                    <TextBlock x:Name="JobNo" Text="JOB NO" Style="{StaticResource HeaderSub}"/>
                    <TextBlock x:Name="Posisi" Text="POSISI" Style="{StaticResource HeaderSub}"/>
                </StackPanel>

                <!-- Customer of the current job: logo (hidden when there is no logo file) + name.
                     A long name wraps onto the lines below (max 3) instead of being cut off. -->
                <Grid Grid.Column="3" Margin="10,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="imgCustomerLogo" Grid.Column="0" Visibility="Collapsed"
                           MaxWidth="72" MaxHeight="56" Stretch="Uniform" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="txtCustomer" Grid.Column="1" Text="CUSTOMER"
                               FontSize="18" FontWeight="Bold" Foreground="#374151"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="66"
                               VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <Button Content="Kendala" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Ganti Target" Style="{StaticResource HeaderButton}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <Button Content="Cetak Ulang" Style="{StaticResource HeaderButton}"/>
                    <Button x:Name="btnPause" Content="Jeda Counter" Style="{StaticResource StopButton}"
                            Click="btnPause_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtClockDate" Text="28 Oktober 2026"
                               FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtClockTime" Text="14:56:12"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= KPI CARDS ================= -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TARGET PRODUKSI" Style="{StaticResource CardTitle}"/>
                    <Border Style="{StaticResource TotalChip}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource TotalCaption}"/>
                            <TextBlock x:Name="txtTargetJam" Text="0" Style="{StaticResource TotalValue}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="txtTarget" Text="0" Style="{StaticResource CardBig}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACTUAL PRODUKSI" Style="{StaticResource CardTitle}" Foreground="#0800FF"/>
                    <Border Style="{StaticResource TotalChip}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource TotalCaption}"/>
                            <TextBlock x:Name="txtActualJam" Text="0" Style="{StaticResource TotalValue}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="txtActual" Text="0" Style="{StaticResource CardBig}" Foreground="#0800FF"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COUNT PRODUKSI" Style="{StaticResource CardTitle}"/>
                    <Border Style="{StaticResource TotalChip}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource TotalCaption}"/>
                            <TextBlock x:Name="txtCountJam" Text="0" Style="{StaticResource TotalValue}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="txtCount" Text="0" Style="{StaticResource CardBig}"/>
                </StackPanel>
            </Border>

            <Border x:Name="bdSelisih" Grid.Column="3" Style="{StaticResource KpiCard}" Background="#EF4444">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtSelisihTitle" Text="SELISIH" Style="{StaticResource CardTitle}"/>
                    <Border Style="{StaticResource TotalChip}">
                        <DockPanel>
                            <TextBlock x:Name="txtSelisihCaption" Style="{StaticResource TotalCaption}"/>
                            <TextBlock x:Name="txtSelisihJam" Text="0" Style="{StaticResource TotalValue}" Foreground="Black"/>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="txtSelisih" Text="0" Style="{StaticResource CardBig}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Row="2" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>   <!-- scan panel: fixed width (half of the original 340) -->
                <ColumnDefinition Width="*"/>     <!-- tabs: takes the rest -->
            </Grid.ColumnDefinitions>

            <!-- Scan panel -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>   <!-- inline scan warning -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>   <!-- list fills the rest -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SCAN BARCODE/QR"/>

                    <TextBox x:Name="txtScan" Grid.Row="1" Height="24" Margin="0,5"
                             KeyDown="txtScan_KeyDown"
                             LostKeyboardFocus="txtScan_LostKeyboardFocus"/>

                    <!-- Inline warning (replaces the old pop-up window). Never takes focus, so scanning is not interrupted. -->
                    <Border x:Name="scanBanner" Grid.Row="2" Visibility="Collapsed"
                            Margin="0,0,0,5" Padding="10,6" CornerRadius="4"
                            BorderThickness="4,0,0,0" Focusable="False" IsHitTestVisible="False"
                            Background="#FEF2F2" BorderBrush="Firebrick">
                        <StackPanel>
                            <TextBlock x:Name="txtBannerTitle" FontSize="14" FontWeight="Bold" Foreground="Firebrick"/>
                            <TextBlock x:Name="txtBannerMessage" FontSize="13" TextWrapping="Wrap" Foreground="Black"/>
                            <TextBlock x:Name="txtBannerSerial" FontSize="12" FontFamily="Consolas" Foreground="DimGray"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="txtScanPerBox" Grid.Row="3" Text="SCAN per BOX" TextWrapping="Wrap"/>

                    <Border Grid.Row="4" Background="#EEF4FA" Padding="8,4" Margin="0,5,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="txtScanned" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2F6FE4"/>
                                <TextBlock Text=" / " FontSize="24" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock x:Name="txtPerBox" Text="0" FontSize="24" FontWeight="Bold" Foreground="#4B5563"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPallet" Text="Pallet"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="lstScans" Grid.Row="5" Margin="0,10,0,0"
                             d:ItemsSource="{d:SampleData ItemCount=20}"
                             BorderBrush="Black" Background="#FFF1E2E2" FontFamily="Consolas"/>
                </Grid>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Column="1" Margin="10" Padding="2,6,2,2">
                <TabItem Header="Jadwal Produksi">
                    <DataGrid x:Name="dgvSchedule"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="Aquamarine" BorderThickness="0"
                              MinRowHeight="38" FontSize="14"
                              AlternationCount="2"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              RowStyle="{StaticResource GridRow}"
                              CellStyle="{StaticResource GridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Urutan"      Binding="{Binding Urutan}"     Width="0.8*"/>
                            <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="1.7*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Posisi + Part" Binding="{Binding PosisiPart}" Width="1.4*"/>
                            <DataGridTextColumn Header="Jumlah"      Binding="{Binding Jumlah}"     Width="*"/>
                            <DataGridTextColumn Header="Scan"        Binding="{Binding Discan}"     Width="*"/>
                            <DataGridTextColumn Header="Count"       Binding="{Binding Count}"      Width="*"/>

                            <!-- Start time (finished job: real; others: expected) -->
                            <DataGridTemplateColumn Header="Mulai" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MulaiText}" Style="{StaticResource TimeMain}"/>
                                            <TextBlock Text="{Binding MulaiNote}" Style="{StaticResource TimeNote}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- End time (finished job: real; others: expected end) -->
                            <DataGridTemplateColumn Header="Selesai" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelesaiText}" Style="{StaticResource TimeMain}"/>
                                            <TextBlock Text="{Binding SelesaiNote}" Style="{StaticResource TimeNote}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Planned end minus expected end: green + = ahead, red - = late, grey = on time -->
                            <DataGridTemplateColumn Header="Selisih Waktu" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border CornerRadius="3" Padding="8,1" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#9CA3AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DiffKind}" Value="Early">
                                                                <Setter Property="Background" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DiffKind}" Value="Late">
                                                                <Setter Property="Background" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DiffText}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding DiffNote}" Style="{StaticResource TimeNote}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Status"      Binding="{Binding Status}"     Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Terima Box / Pallet"/>
                <TabItem Header="Tampilan Web"/>
                <TabItem Header="Log Serial / COM"/>
            </TabControl>
        </Grid>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="3" Background="White" Padding="24,8">
            <Grid>
                <TextBlock x:Name="txtStatus" VerticalAlignment="Center" FontSize="16" Foreground="#6B7280"
                           TextWrapping="Wrap" Margin="0,0,180,0"/>
                <Button x:Name="btnKeluar" Content="KELUAR" Style="{StaticResource ExitButton}"
                        HorizontalAlignment="Right" Click="btnKeluar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>